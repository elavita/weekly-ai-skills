{
  "github": {
    "min_stars": 500,
    "windows_days": [7, 30, 90, 180, 365],
    "max_projects": 5,
    "search_terms": ["AI skill", "AI agent", "MCP", "AI tool"],
    "per_page": 100,
    "max_pages_per_query": 3,
    "request_timeout_seconds": 20
  },
  "zen": {
    "endpoint": "https://opencode.ai/zen/v1",
    "model": "deepseek-v4-flash-free",
    "auth_header": "Authorization",
    "auth_scheme": "Bearer",
    "timeout_seconds": 45
  },
  "content": {
    "language": "zh-CN",
    "report_title": "AI 技能周报",
    "audience": "关注 AI Agent、MCP 与效率工具的中文开发者",
    "include_disclaimer": true
  },
  "images": {
    "width": 1200,
    "height": 630,
    "max_bytes": 5242880,
    "timeout_seconds": 15,
    "allowed_content_types": ["image/png", "image/jpeg", "image/webp", "image/gif"],
    "readme_keywords": ["screenshot", "demo", "preview", "showcase"],
    "badge_markers": ["shields.io", "badge", "badgen.net", "github.com/actions/workflows"]
  }
}
